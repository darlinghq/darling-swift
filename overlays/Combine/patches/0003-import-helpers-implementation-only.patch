+++ b/Publishers/Publishers.Breakpoint.swift
@@ -8,7 +8,7 @@
 #if !WASI
 
 #if canImport(COpenCombineHelpers)
-import COpenCombineHelpers
+@_implementationOnly import COpenCombineHelpers
 #endif
 
 extension Publisher {
