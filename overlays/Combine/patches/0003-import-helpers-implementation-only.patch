Import COpenCombineHelpers as implementation-only

The C helpers are an implementation detail, as they are in Apple's Combine,
which has no C module dependency. With a plain import, Combine.swiftmodule
records COpenCombineHelpers as a required module, so every client that imports
Combine (or Foundation, whose KVO publisher imports Combine) would fail with
"missing required module 'COpenCombineHelpers'" unless it also passes the
fetched checkout's module map. No helper type appears in a public or
@usableFromInline declaration, so no mangled name changes.

--- a/CombineIdentifier.swift
+++ b/CombineIdentifier.swift
@@ -6,7 +6,7 @@
 //
 
 #if canImport(COpenCombineHelpers)
-import COpenCombineHelpers
+@_implementationOnly import COpenCombineHelpers
 #endif
 
 #if WASI
--- a/Helpers/Locking.swift
+++ b/Helpers/Locking.swift
@@ -6,7 +6,7 @@
 //
 
 #if canImport(COpenCombineHelpers)
-import COpenCombineHelpers
+@_implementationOnly import COpenCombineHelpers
 #endif
 
 #if WASI
